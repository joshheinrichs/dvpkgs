# Lock-file driven dependency fetchers (upstream tarballs themselves come from sources.toml).
#
# Each is a dynamic derivation: a small producer (builder/fetch/*.nu, run under builder-rpc-v0
# with `jig nix-store`) reads the lock file out of `source`, writes one builtin:fetchurl derivation
# per artefact using the hash the lock already carries, plus a derivation assembling them, and
# submits that .drv as its output. The caller gets `output_of` it: Nix downloads, caches and
# verifies per file, nothing is hashed by us, no lock file is copied into this repo. Needs
# `dynamic-derivations ca-derivations` on the daemon. Dependencies without a hash in the lock
# (git, path) are rejected by the producer.

load("//nix/lib.star", "to_string")

_PRODUCER_HELPERS = ["sys-libs.nu", "sys-libs.json", "pep508.nu", "glob.nu"]

def _producer_file(p):
    rel = p.rpartition("/builder/")[2]
    return rel == "fetch" or rel.startswith("fetch/") or rel in _PRODUCER_HELPERS

def producers():
    """fetch/ plus the helpers it imports from its parent. Build systems and the build pipeline
    stay out, so editing them does not refetch every lock."""
    return path("//builder", name = "producers", filter = lambda p, _t: _producer_file(p))

def empty():
    return path("//nix/empty", name = "empty")

def _dynamic_(e, drv_name, script, env):
    attrs = dict(
        name = drv_name,
        system = e.system,
        seed = e.nu,
        jig = e.jig,
        builder = to_string(e.nu) + "/bin/nu",
        args = [e.producers + "/" + script],
        PATH = to_string(e.jig) + "/bin:" + to_string(e.nu) + "/bin",
        requiredSystemFeatures = ["builder-rpc-v0"],
        preferLocalBuild = True,
        __contentAddressed = True,
        outputHashMode = "text",
        outputHashAlgo = "sha256",
    )
    attrs.update(env)
    return output_of(derivation(**attrs).out, "out")

# nix names a text-CA output after its derivation minus ".drv": one suffix per stage
def _dynamic(e, name, script, env):
    return _dynamic_(e, name + ".drv", script, env)

# for producers that end in `dyn-drv stage` (a second producer) rather than `dyn-drv collect`
def _two_stage(e, name, script, env):
    return output_of(_dynamic_(e, name + ".drv.drv", script, env), "out")

def _lock_file(f):
    return "" if f == None else f

# Cargo.lock -> a directory cargo accepts as [source.vendored-sources] (crates unpacked, with
# .cargo-checksum.json). builder/systems/cargo.nu points CARGO_HOME's config at it.
def _cargo_vendor(e, source):
    return _dynamic(e, "cargo-vendor", "fetch/cargo.nu", {"source": source})

# package-lock.json (v2/v3) -> { package-lock.json } with every `resolved` rewritten to
# file:<store path>. `lockFile`: for upstreams that ship none (generated by `uptrack lock`).
def _npm_deps(e, source, root = ".", lockFile = None):
    return _dynamic(e, "npm-deps", "fetch/npm.nu", {"source": source, "root": root, "lockFile": _lock_file(lockFile)})

# pnpm-lock.yaml (v9) -> registry/<url path>, a file:// registry builder/systems/pnpm.nu installs from offline.
def _pnpm_deps(e, source, root = "."):
    return _dynamic(e, "pnpm-deps", "fetch/pnpm.nu", {"source": source, "root": root})

# yarn.lock (classic v1) -> a yarn offline mirror directory.
def _yarn_deps(e, source, root = "."):
    return _dynamic(e, "yarn-deps", "fetch/yarn.nu", {"source": source, "root": root})

# bun.lock -> { p/<name>@<version>/ (unpacked), index.json }
def _bun_deps(e, source, root = "."):
    return _dynamic(e, "bun-deps", "fetch/bun.nu", {"source": source, "root": root})

# deno.lock (v4+) -> a $DENO_DIR for `deno … --cached-only`; jsr hashes pin metadata that
# pins the files, hence two stages (builder/fetch/deno.nu, deno-files.nu).
def _deno_deps(e, source, root = "."):
    return _two_stage(e, "deno-deps", "fetch/deno.nu", {"source": source, "root": root})

# uv.lock -> { dist/, vendor/, plan.json }: one artefact per package of the project's runtime
# closure, installed by builder/systems/pyapp.nu
def _python_deps(e, source, python, root = ".", extras = [], groups = [], prefer = "wheel", sdist = [], git = [], environ = "{}"):
    return _two_stage(e, "python-deps", "fetch/pypi.nu", {
        "source": source,
        "root": root,
        "cpu": e.cpu,
        "prefer": prefer,
        "environ": environ,
        "pythonVersion": python.version,
        "extras": ",".join(extras),
        "groups": ",".join(groups),
        "sdist": ",".join(sdist),
        "git": "\n".join([g["name"] + "=" + g["path"] for g in git]),
    })

# Gemfile.lock (with a CHECKSUMS section, Bundler >= 2.6) -> { vendor/cache/*.gem, Gemfile.lock }
def _gems(e, source, root = ".", lockFile = None):
    return _dynamic(e, "gems", "fetch/gems.nu", {
        "source": source,
        "root": root,
        "lockFile": _lock_file(lockFile),
        "gemPlatform": e.cpu + "-linux",
    })

# mix.lock or rebar.lock -> packages/hexpm/<name>-<version>.tar (builder/fetch/hex.nu)
def _hex_deps(e, source, root = "."):
    return _dynamic(e, "hex-deps", "fetch/hex.nu", {"source": source, "root": root})

# locks/hackage.toml, the Haskell version set -> one file+noindex repository for all cabal packages
def _hackage_set(e, locks = None):
    return _dynamic(e, "hackage-set", "fetch/hackage.nu", {"locks": locks or path("//locks/hackage.toml")})

# locks/luarocks.toml -> a rocks server directory (.src.rock files + manifest) for luarocks.nu
def _lua_rocks_set(e, lua, locks = None):
    return _dynamic(e, "luarocks-set", "fetch/luarocks.nu", {
        "locks": locks or path("//locks/luarocks.toml"),
        "luaVersion": lua.version,
    })

# go.sum -> a GOPROXY=file:// tree. go.sum's h1: hashes are not file hashes, so .mod/.zip
# sha256s come from `locks` (locks/go.toml, filled by `uptrack lock`); only this package's
# subset lands in the output, so unrelated table edits rebuild nothing.
def _go_modules(e, source, root = ".", locks = None):
    return _dynamic(e, "go-modules", "fetch/go.nu", {
        "source": source,
        "root": root,
        "locks": locks or path("//locks/go.toml"),
    })

# VisualStudio.vsman -> {crt,sdk}/: MSVC CRT with the STL, UCRT and the Windows SDK headers
# and import libraries for one cpu, the sysroot of the msvc platforms. Unfree (Visual Studio
# license terms), so CI keeps it out of the public cache.
def _windows_sdk(e, manifest, arch):
    return _dynamic(e, "windows-sdk-" + arch, "fetch/winsdk.nu", {
        "manifest": manifest,
        "arch": arch,
        "sevenzip": to_string(e.sevenzip),
        "sevenzip_drv": e.sevenzip.drv_path,
    })

def make_fetch(jig, nu, system, cpu, producers, sevenzip = None):
    """The fetchers for one platform: a struct of functions, each `(**args) -> path`. Data
    (partials over the functions above), so a set makes it once."""
    e = struct(jig = jig, nu = nu, system = system, cpu = cpu, producers = producers, sevenzip = sevenzip)
    return struct(
        cargoVendor = partial(_cargo_vendor, e),
        npmDeps = partial(_npm_deps, e),
        pnpmDeps = partial(_pnpm_deps, e),
        yarnDeps = partial(_yarn_deps, e),
        bunDeps = partial(_bun_deps, e),
        denoDeps = partial(_deno_deps, e),
        pythonDeps = partial(_python_deps, e),
        gems = partial(_gems, e),
        hexDeps = partial(_hex_deps, e),
        hackageSet = partial(_hackage_set, e),
        luaRocksSet = partial(_lua_rocks_set, e),
        goModules = partial(_go_modules, e),
        empty = empty,
        windowsSdk = partial(_windows_sdk, e),
    )
